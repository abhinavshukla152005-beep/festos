# Qloo hackathon key. Without it FestOS runs in clearly-labelled DEMO mode.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
PORT=8787

# PayPal sandbox app credentials (developer.paypal.com → Apps & Credentials →
# Sandbox). Without these, settlement runs in a labelled simulator that follows
# the same order lifecycle. Sandbox only: this app has no live-money code path.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public origin used for PayPal return URLs. Set this on hosts where the proxy
# host is not the browser-visible domain (Vercel preview URLs usually are).
PUBLIC_BASE_URL=
